pipeline {
    agent any

    parameters {
        string(name: 'APPLICATION_REPO', defaultValue: 'https://github.com/Suraj-Coder1/inventory-management-system.git', description: 'Application Git repository')
        string(name: 'APPLICATION_BRANCH', defaultValue: 'main', description: 'Git branch')
        string(name: 'APPLICATION_CONFIG', defaultValue: 'deploy-config/inventory.env.example', description: 'Application contract')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run automated tests')
        booleanParam(name: 'DEPLOY_TO_K8S', defaultValue: true, description: 'Deploy to Kubernetes')
    }

    environment {
        KUBECONFIG = '/var/jenkins_home/jenkins-kubeconfig'
    }

    stages {
        stage('Start') {
            steps {
                echo 'CLOUD NATIVE DEVOPS AUTOMATION PLATFORM'
                echo "Repository: ${params.APPLICATION_REPO}"
                echo "Branch: ${params.APPLICATION_BRANCH}"
                echo "Contract: ${params.APPLICATION_CONFIG}"
            }
        }

        stage('Validate Input') {
            steps {
                script {
                    if (!params.APPLICATION_REPO?.trim()) {
                        error('APPLICATION_REPO is required.')
                    }
                }
            }
        }

        stage('Checkout Application') {
            steps {
                deleteDir()
                git url: params.APPLICATION_REPO, branch: params.APPLICATION_BRANCH
            }
        }

        stage('Load Contract') {
            steps {
                sh '''
                    set -e

                    test -f "$APPLICATION_CONFIG" || {
                        echo "ERROR: Contract not found: $APPLICATION_CONFIG"
                        exit 1
                    }

                    set -a
                    . "$APPLICATION_CONFIG"
                    set +a

                    test -n "${APP_NAME:-}" || { echo "ERROR: Missing contract variable: APP_NAME"; exit 1; }
                    test -n "${APP_SLUG:-}" || { echo "ERROR: Missing contract variable: APP_SLUG"; exit 1; }
                    test -n "${K8S_NAMESPACE:-}" || { echo "ERROR: Missing contract variable: K8S_NAMESPACE"; exit 1; }
                    test -n "${APP_PORT:-}" || { echo "ERROR: Missing contract variable: APP_PORT"; exit 1; }
                    test -n "${HEALTH_PATH:-}" || { echo "ERROR: Missing contract variable: HEALTH_PATH"; exit 1; }
                    test -n "${K8S_MANIFESTS:-}" || { echo "ERROR: Missing contract variable: K8S_MANIFESTS"; exit 1; }
                    test -n "${DOCKERFILES:-}" || { echo "ERROR: Missing contract variable: DOCKERFILES"; exit 1; }
                    test -n "${DOCKER_IMAGES:-}" || { echo "ERROR: Missing contract variable: DOCKER_IMAGES"; exit 1; }
                    test -n "${K8S_APP_MANIFESTS:-}" || { echo "ERROR: Missing contract variable: K8S_APP_MANIFESTS"; exit 1; }
                    test -n "${K8S_DEPLOYMENTS:-}" || { echo "ERROR: Missing contract variable: K8S_DEPLOYMENTS"; exit 1; }
                    test -n "${K8S_CONTAINERS:-}" || { echo "ERROR: Missing contract variable: K8S_CONTAINERS"; exit 1; }

                    echo "Contract loaded successfully."
                    echo "Application: $APP_NAME"
                    echo "Namespace: $K8S_NAMESPACE"
                    echo "Port: $APP_PORT"
                    echo "Health: $HEALTH_PATH"
                    echo "Kubernetes manifests: $K8S_MANIFESTS"
                    echo "Dockerfiles: $DOCKERFILES"
                    echo "Docker images: $DOCKER_IMAGES"
                '''
            }
        }
        stage('Automated Tests') {
            when {
                expression { params.RUN_TESTS }
            }
            steps {
                sh '''
                    set -eu

                    test -f "$APPLICATION_CONFIG" || {
                        echo "ERROR: Application config not found."
                        exit 1
                    }

                    test -f client/package.json
                    cd client
                    npm ci
                    npm run lint
                    npm run build
                    cd ..

                    test -f server/package.json
                    cd server
                    npm ci
                    node --check src/index.js

                    echo "Frontend lint/build and backend syntax checks passed."
                '''
            }
        }

        stage('Security Validation') {
            steps {
                sh '''
                    set -e

                    set -a
                    . "$APPLICATION_CONFIG"
                    set +a

                    for dir in . client frontend server backend
                    do
                        if [ -f "$dir/package.json" ]; then
                            echo "Security audit: $dir"
                            (cd "$dir" && npm audit --audit-level=high || true)
                        fi
                    done

                    echo "Security validation completed."
                '''
            }
        }

        stage('Docker Validation') {
            steps {
                sh '''
                    set -e

                    set -a
                    . "$APPLICATION_CONFIG"
                    set +a

                    for file in $DOCKERFILES
                    do
                        test -f "$file" || {
                            echo "ERROR: Dockerfile not found: $file"
                            exit 1
                        }
                        echo "Dockerfile found: $file"
                    done
                '''
            }
        }

        stage('Kubernetes Validation') {
            when {
                expression { params.DEPLOY_TO_K8S }
            }
            steps {
                sh '''
                    set -e

                    set -a
                    . "$APPLICATION_CONFIG"
                    set +a

                    kubectl get nodes

                    for file in $K8S_MANIFESTS
                    do
                        test -f "$file" || {
                            echo "ERROR: Kubernetes manifest not found: $file"
                            exit 1
                        }
                        echo "Manifest found: $file"
                    done
                '''
            }
        }

        stage('Build and Import Docker Images') {
            when {
                expression { params.DEPLOY_TO_K8S }
            }
            steps {
                sh '''
                    set -eu
                    set -a
                    . "$APPLICATION_CONFIG"
                    set +a

                    count_words() {
                        count=0
                        for item do count=$((count + 1)); done
                        printf '%s' "$count"
                    }

                    list_item() {
                        wanted=$1
                        shift
                        for item do
                            if [ "$wanted" -eq 1 ]; then
                                printf '%s' "$item"
                                return 0
                            fi
                            wanted=$((wanted - 1))
                        done
                        return 1
                    }

                    [ "$(count_words $DOCKERFILES)" -eq "$(count_words $DOCKER_IMAGES)" ] || {
                        echo "ERROR: Dockerfile and image counts differ."
                        exit 1
                    }

                    index=1
                    for file in $DOCKERFILES
                    do
                        image=$(list_item "$index" $DOCKER_IMAGES)
                        tag="$image:$BUILD_NUMBER"
                        archive=".image-${index}-${BUILD_NUMBER}.tar"

                        docker build --pull=false -f "$file" -t "$tag" "$(dirname "$file")"
                        docker save -o "$archive" "$tag"
                        docker exec -i minikube ctr -n k8s.io images import - < "$archive"
                        rm -f "$archive"

                        echo "Built and imported $tag"
                        index=$((index + 1))
                    done
                '''
            }
        }

        stage('Deploy and Verify') {
            when {
                expression { params.DEPLOY_TO_K8S }
            }
            steps {
                sh '''
                    set -eu
                    set -a
                    . "$APPLICATION_CONFIG"
                    set +a

                    count_words() {
                        count=0
                        for item do count=$((count + 1)); done
                        printf '%s' "$count"
                    }

                    list_item() {
                        wanted=$1
                        shift
                        for item do
                            if [ "$wanted" -eq 1 ]; then
                                printf '%s' "$item"
                                return 0
                            fi
                            wanted=$((wanted - 1))
                        done
                        return 1
                    }

                    image_count=$(count_words $DOCKER_IMAGES)
                    [ "$image_count" -eq "$(count_words $K8S_DEPLOYMENTS)" ] &&
                    [ "$image_count" -eq "$(count_words $K8S_CONTAINERS)" ] || {
                        echo "ERROR: Image, deployment and container counts differ."
                        exit 1
                    }

                    rollback_file=".rollback-images-$BUILD_NUMBER"
                    : > "$rollback_file"

                    # Save current image references BEFORE applying manifests.
                    index=1
                    for deployment in $K8S_DEPLOYMENTS
                    do
                        container=$(list_item "$index" $K8S_CONTAINERS)
                        if previous=$(kubectl -n "$K8S_NAMESPACE" get deployment "$deployment" \
                            -o 'jsonpath={.spec.template.spec.containers[0].image}' 2>/dev/null) &&
                            [ -n "$previous" ]; then
                            printf '%s|%s|%s\\n' "$deployment" "$container" "$previous" >> "$rollback_file"
                        else
                            printf '%s|%s|%s\\n' "$deployment" "$container" "__NONE__" >> "$rollback_file"
                        fi
                        index=$((index + 1))
                    done

                    rollback() {
                        echo "Restoring previous application images..."
                        while IFS='|' read -r deployment container previous
                        do
                            [ -n "$deployment" ] || continue
                            if [ "$previous" = "__NONE__" ]; then
                                kubectl -n "$K8S_NAMESPACE" delete deployment "$deployment" --ignore-not-found=true || true
                            else
                                kubectl -n "$K8S_NAMESPACE" set image \
                                    "deployment/$deployment" "$container=$previous" || true
                                kubectl -n "$K8S_NAMESPACE" rollout status \
                                    "deployment/$deployment" --timeout=120s || true
                            fi
                        done < "$rollback_file"
                    }

                    for file in $K8S_APP_MANIFESTS
                    do
                        test -f "$file" || {
                            echo "ERROR: Manifest not found: $file"
                            rollback
                            exit 1
                        }
                        if ! kubectl apply -n "$K8S_NAMESPACE" -f "$file"; then
                            rollback
                            exit 1
                        fi
                    done

                    index=1
                    for deployment in $K8S_DEPLOYMENTS
                    do
                        container=$(list_item "$index" $K8S_CONTAINERS)
                        image=$(list_item "$index" $DOCKER_IMAGES)
                        tag="$image:$BUILD_NUMBER"

                        if ! kubectl -n "$K8S_NAMESPACE" set image \
                            "deployment/$deployment" "$container=$tag"; then
                            rollback
                            exit 1
                        fi

                        if ! kubectl -n "$K8S_NAMESPACE" rollout status \
                            "deployment/$deployment" --timeout=180s; then
                            rollback
                            exit 1
                        fi

                        index=$((index + 1))
                    done

                    kubectl -n "$K8S_NAMESPACE" get deployments
                    rm -f "$rollback_file"
                    echo "Deployment and rollout verification succeeded."
                '''
            }
        }

    }

    post {
        success {
            echo 'Reusable platform validation SUCCESS.'
        }

        failure {
            echo 'Reusable platform validation FAILED.'
        }
    }
}
